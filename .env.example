# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Riot Games API Credentials
# Get your API key at: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-api-key-here

# VALORANT Act / Season UUID
# Current Live Act: Act V (ends Oct 14, 2026): 8102cd81-43a0-d0d7-bd59-47b8fe9bed1b
# Next Upcoming Act: Act VI (starts Oct 14, 2026): d816f426-48ea-f052-117f-9697a155b319
ACT_ID=8102cd81-43a0-d0d7-bd59-47b8fe9bed1b

# VALORANT Match API Region (Regional match endpoint)
# Options: na, eu, ap, kr, latam, br
VAL_REGION=na

# Riot Account API Routing Region (Account endpoint)
# Options: americas (for na/latam/br), europe (for eu), asia (for ap/kr), esports
ROUTING_REGION=americas

# Background Sync Interval in Minutes (Default: 15)
SYNC_INTERVAL_MINUTES=15

# Minimum matches required to appear on the Average Performance Score leaderboard
MIN_MATCHES=1

# SQLite Database File Path
DB_PATH=val_tracker.db
